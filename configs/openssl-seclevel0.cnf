# B-1 reproduction config: lower the security level so OpenSSL 3.0.13
# accepts ML-DSA-65 certificates (its default level 1 rejects them with
# "ca md too weak" because ML-DSA has no message digest). NOT for production.
openssl_conf = openssl_init
[openssl_init]
providers = provider_sect
ssl_conf = ssl_sect
[provider_sect]
default = default_sect
oqsprovider = oqsprovider_sect
[default_sect]
activate = 1
[oqsprovider_sect]
activate = 1
[ssl_sect]
system_default = system_default_sect
[system_default_sect]
CipherString = DEFAULT@SECLEVEL=0
MinProtocol = TLSv1.3
