# OpenSSL config for the TLS handshake harness: activate the default provider
# and oqsprovider (found via OPENSSL_MODULES). Default security level (1).
# Used for all post-remediation handshake measurements.
openssl_conf = openssl_init
[openssl_init]
providers = provider_sect
[provider_sect]
default = default_sect
oqsprovider = oqsprovider_sect
[default_sect]
activate = 1
[oqsprovider_sect]
activate = 1
